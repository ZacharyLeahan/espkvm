# SPDX-License-Identifier: Apache-2.0
# Recommended Xbox LCD profile for Function EV rev 3.2 + Waveshare 3.5 DSI (E).
# Locally verified; not vendor-supported. Keep PPA off (observed tearing).
CONFIG_KVM_DSI_PREVIEW=y
CONFIG_KVM_DSI_PREVIEW_BUFFERS=3
# CONFIG_KVM_DSI_PREVIEW_PPA is not set
# CONFIG_KVM_DSI_PREVIEW_STANDALONE is not set
# CONFIG_KVM_DSI_PREVIEW_HOST_PATTERN is not set
# CONFIG_KVM_DSI_PREVIEW_ICN6211_PROBE is not set
CONFIG_KVM_DSI_PREVIEW_ICN6211_DISABLE_BIST=y
CONFIG_KVM_DSI_PREVIEW_ICN6211_MIPI_PLL=y
